# Econnet · frontend. Todo lo que empieza por VITE_ ES PÚBLICO: nunca un secreto.
VITE_API_URL="http://localhost:3000"

# Solo para el prerenderizado del build (la lee Node, no el navegador). Si se
# pone la URL de la API en VITE_API_URL para esto, el navegador llama a otro
# origen y se come un CORS. En producción, con la API detrás del mismo
# dominio, VITE_API_URL va vacía y esta apunta a la API interna.
API_URL="http://localhost:3000"
VITE_WHATSAPP=""

# ── Datos de la empresa que salen impresos en los textos legales ────────────
# Mientras estén vacíos, la web enseña el hueco en amarillo en vez de
# inventarse un dato. Son públicos: aparecen en la propia página.
# Los datos de empresa (razón social, RUT, dirección, teléfono, horario) ya NO
# viven aquí: se ponen en el panel, en «Ajustes → Datos legales», y los sirve
# la API. Una variable VITE_ se hornea en el paquete del navegador, así que
# corregir una letra del RUT obligaba a reconstruir y volver a publicar.
